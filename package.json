{
  "name": "route-change-tracker",
  "version": "0.1.0",
  "description": "Local web app for tracking school bus route time changes",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node src/server.js",
    "start:practice": "ENV_FILE=.env.practice node src/server.js",
    "seed": "node scripts/seed-sample-data.js",
    "seed:practice": "ENV_FILE=.env.practice node scripts/seed-practice-data.js",
    "reset:practice": "ENV_FILE=.env.practice node scripts/reset-practice-data.js",
    "fresh:practice": "npm run reset:practice && npm run start:practice",
    "seed:queue-scenarios": "node scripts/seed-admin-queue-scenarios.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1"
  }
}
