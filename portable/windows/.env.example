# Shared data folder on OneDrive (create this folder first — see SETUP-ONEDRIVE.md).
# Use the FULL path from File Explorer's address bar. Example:
# DATA_DIR=C:\Users\YOUR_USERNAME\OneDrive - District\RouteChangeTracker
DATA_DIR=C:\Users\REPLACE_ME\OneDrive - District\RouteChangeTracker

# Local server port (change only if 3847 is already in use)
PORT=3847
