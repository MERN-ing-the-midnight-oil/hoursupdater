# Shared folder root (OneDrive when going live, or a local folder for testing).
# What people open in Explorer/Finder. Layout:
#   DATA_DIR/
#     RouteChangeTracker.xlsx   ← auto-generated, read-facing
#     _app_data/                ← internal JSON source of truth (do not hand-edit)
# Example Windows: C:\Users\username\OneDrive - District\RouteChangeTracker
# Example macOS:   /Users/username/OneDrive - District/RouteChangeTracker
# Windows portable package: see SETUP-ONEDRIVE.md (folder must already exist).
DATA_DIR=./data

# Local server port (default 3847)
PORT=3847

# Teamster Time Changes Dashboard accounts (Supabase). Leave blank to run
# this computer only, with no sign-in. The anon key is public; row rules
# in office-tracker/supabase/schema.sql keep the routes behind a sign-in.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Timesheet reader on the Teamster Time Changes Dashboard. The key stays on
# the office server. A photo is sent for one read and is not stored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
