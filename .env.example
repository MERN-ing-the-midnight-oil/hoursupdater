# Shared OneDrive folder root (what people open in Explorer/Finder).
# Layout:
#   DATA_DIR/
#     RouteChangeTracker.xlsx   ← auto-generated, read-facing
#     _app_data/                ← internal JSON source of truth (do not hand-edit)
# Example Windows: C:\Users\username\OneDrive - District\RouteChangeTracker
# Example macOS:   /Users/username/OneDrive - District/RouteChangeTracker
DATA_DIR=./data

# Local server port (default 3847)
PORT=3847
